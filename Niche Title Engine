<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Niche Title Engine - AI YouTube Title Researcher</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- React & ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel for JSX -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased">

    <div id="root" class="flex flex-col flex-grow"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        const PIPELINE_STEPS = [
            "Identify top-performing channels in the micro niche",
            "Pull recent trending/outlier videos in that niche",
            "Analyze title patterns from high-performers (view-to-sub ratio, recency, engagement)",
            "Extract common keyword/phrase patterns from winning titles",
            "Identify proven title formats (Why, When, How, Listicle, Curiosity Gap, Warning/Mistake)",
            "Cross-reference formats against the micro niche's top content",
            "Generating high-conversion titles & actionable rationales"
        ];

        function App() {
            const [broadNiche, setBroadNiche] = useState('Sports');
            const [microNiche, setMicroNiche] = useState('Golf');
            const [geminiKey, setGeminiKey] = useState(localStorage.getItem('nte_gemini_key') || '');
            const [ytKey, setYtKey] = useState(localStorage.getItem('nte_yt_key') || '');
            const [showSettings, setShowSettings] = useState(false);

            const [isLoading, setIsLoading] = useState(false);
            const [currentStepIndex, setCurrentStepIndex] = useState(0);
            const [titles, setTitles] = useState([]);
            const [copiedIndex, setCopiedIndex] = useState(null);
            const [error, setError] = useState('');

            useEffect(() => {
                localStorage.setItem('nte_gemini_key', geminiKey);
            }, [geminiKey]);

            useEffect(() => {
                localStorage.setItem('nte_yt_key', ytKey);
            }, [ytKey]);

            // Optional YouTube Data API contextual enrichment helper
            const fetchYouTubeContext = async (query) => {
                if (!ytKey) return null;
                try {
                    const url = `https://www.googleapis.com/youtube/v3/search?part=snippet&maxResults=5&q=${encodeURIComponent(query)}&type=video&order=viewCount&key=${ytKey}`;
                    const res = await fetch(url);
                    if (res.ok) {
                        const data = await res.json();
                        return data.items.map(item => item.snippet.title).join("; ");
                    }
                } catch (e) {
                    console.warn("YouTube API search failed or skipped:", e);
                }
                return null;
            };

            const handleSubmit = async (e) => {
                e.preventDefault();
                if (!broadNiche.trim() || !microNiche.trim()) return;

                if (!geminiKey.trim()) {
                    setShowSettings(true);
                    setError('Please provide your Gemini API key to run real-time grounded title generation.');
                    return;
                }

                setError('');
                setIsLoading(true);
                setCurrentStepIndex(0);
                setTitles([]);

                // Step Progression Timer Animation (~56s total across 7 steps)
                const stepInterval = setInterval(() => {
                    setCurrentStepIndex(prev => {
                        if (prev < PIPELINE_STEPS.length - 1) {
                            return prev + 1;
                        }
                        clearInterval(stepInterval);
                        return prev;
                    });
                }, 7500);

                try {
                    // Optional direct YouTube search for extra context string
                    let ytContextString = "";
                    if (ytKey.trim()) {
                        const rawYtData = await fetchYouTubeContext(`${broadNiche} ${microNiche} viral high views`);
                        if (rawYtData) {
                            ytContextString = `\nRaw YouTube API Recent High Performers Sample: "${rawYtData}"`;
                        }
                    }

                    const prompt = `You are a world-class YouTube title strategist. Perform a grounded research deep-dive into the micro-niche "${microNiche}" within the broad niche "${broadNiche}".
                    
Research tasks executed in pipeline:
1. Identify top-performing channels & viral outlier titles in the ${microNiche} niche.
2. Analyze titles with high view-to-subscriber ratios and viral engagement.
3. Extract common high-CTR keyword hooks and formats (Why, When, How, Listicle, Curiosity Gap, Warning/Mistake).${ytContextString}

Generate EXACTLY 10 YouTube video title suggestions engineered for maximum Click-Through-Rate (CTR) in the ${microNiche} niche.

Return ONLY a valid JSON object matching this schema without markdown codeblocks or extra text:
{
  "titles": [
    {
      "title": "Title text here",
      "format": "Why / When / How / Listicle / Curiosity Gap / Warning/Mistake",
      "rationale": "One line explaining why this specific format drives high CTR for this niche."
    }
  ]
}`;

                    const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${geminiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{ role: 'user', parts: [{ text: prompt }] }],
                            tools: [{ googleSearch: {} }], // Enable Google Search Grounding for real-time video/trend context
                            generationConfig: {
                                responseMimeType: 'application/json'
                            }
                        })
                    });

                    clearInterval(stepInterval);

                    if (!res.ok) {
                        throw new Error(`Gemini API error status: ${res.status}`);
                    }

                    const data = await res.json();
                    const rawText = data.candidates?.[0]?.content?.parts?.[0]?.text;
                    const parsed = JSON.parse(rawText);

                    if (parsed.titles && Array.isArray(parsed.titles)) {
                        setTitles(parsed.titles.slice(0, 10));
                    } else {
                        throw new Error("Invalid output format returned by model.");
                    }

                } catch (err) {
                    console.error(err);
                    setError(err.message || 'An error occurred during title research. Check your API key.');
                } finally {
                    setIsLoading(false);
                    clearInterval(stepInterval);
                }
            };

            const copyToClipboard = (text, index) => {
                navigator.clipboard.writeText(text);
                setCopiedIndex(index);
                setTimeout(() => setCopiedIndex(null), 2000);
            };

            return (
                <div className="min-h-screen flex flex-col justify-between">
                    {/* Header */}
                    <header className="bg-slate-900 border-b border-slate-800 sticky top-0 z-20">
                        <div className="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
                            <div className="flex items-center space-x-3">
                                <div className="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white font-black text-xl shadow-lg shadow-indigo-500/20">
                                    <i className="fa-solid fa-bolt"></i>
                                </div>
                                <div>
                                    <h1 className="text-lg font-extrabold tracking-tight text-white">Niche Title Engine</h1>
                                    <p className="text-[11px] font-medium text-slate-400">Grounded YouTube CTR & Outlier Researcher</p>
                                </div>
                            </div>
                            <button 
                                onClick={() => setShowSettings(!showSettings)}
                                className="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold border border-slate-700 transition flex items-center space-x-2"
                            >
                                <i className="fa-solid fa-key text-indigo-400"></i>
                                <span>API Keys</span>
                            </button>
                        </div>
                    </header>

                    {/* Main Content */}
                    <main className="max-w-4xl w-full mx-auto p-4 md:p-6 flex-grow space-y-6">

                        {/* Settings Modal Banner */}
                        {showSettings && (
                            <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-2xl space-y-4">
                                <div className="flex justify-between items-center border-b border-slate-800 pb-3">
                                    <h3 className="text-sm font-extrabold text-white flex items-center gap-2">
                                        <i className="fa-solid fa-sliders text-indigo-400"></i>
                                        API Configuration
                                    </h3>
                                    <button onClick={() => setShowSettings(false)} className="text-slate-400 hover:text-white text-xs font-bold">
                                        <i className="fa-solid fa-xmark text-sm"></i>
                                    </button>
                                </div>
                                <div className="space-y-3">
                                    <div>
                                        <label className="block text-xs font-bold text-slate-300 mb-1">
                                            Gemini API Key <span className="text-indigo-400">* (Required)</span>
                                        </label>
                                        <input 
                                            type="password" 
                                            value={geminiKey} 
                                            onChange={(e) => setGeminiKey(e.target.value)}
                                            placeholder="AIzaSy..." 
                                            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-indigo-500"
                                        />
                                    </div>
                                    <div>
                                        <label className="block text-xs font-bold text-slate-300 mb-1">
                                            YouTube Data API Key <span className="text-slate-500">(Optional for direct search cross-referencing)</span>
                                        </label>
                                        <input 
                                            type="password" 
                                            value={ytKey} 
                                            onChange={(e) => setYtKey(e.target.value)}
                                            placeholder="AIzaSy..." 
                                            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-indigo-500"
                                        />
                                    </div>
                                </div>
                            </div>
                        )}

                        {error && (
                            <div className="bg-rose-950/50 border border-rose-800/80 rounded-2xl p-4 text-xs font-semibold text-rose-300 flex items-center gap-3">
                                <i className="fa-solid fa-triangle-exclamation text-base"></i>
                                <span>{error}</span>
                            </div>
                        )}

                        {/* Input Form */}
                        <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-4">
                            <form onSubmit={handleSubmit} className="space-y-4">
                                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label className="block text-xs font-extrabold uppercase tracking-wider text-slate-400 mb-1.5">
                                            Broad Niche
                                        </label>
                                        <input 
                                            type="text" 
                                            required
                                            value={broadNiche}
                                            onChange={(e) => setBroadNiche(e.target.value)}
                                            placeholder="e.g. Sports, Gaming, Tech, Finance" 
                                            className="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm font-semibold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                        />
                                    </div>
                                    <div>
                                        <label className="block text-xs font-extrabold uppercase tracking-wider text-slate-400 mb-1.5">
                                            Micro Niche
                                        </label>
                                        <input 
                                            type="text" 
                                            required
                                            value={microNiche}
                                            onChange={(e) => setMicroNiche(e.target.value)}
                                            placeholder="e.g. Golf, Speedrunning, Mechanical Keyboards" 
                                            className="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm font-semibold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                        />
                                    </div>
                                </div>

                                <button 
                                    type="submit" 
                                    disabled={isLoading}
                                    className={`w-full bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold py-3.5 px-6 rounded-2xl transition shadow-lg shadow-indigo-600/30 flex items-center justify-center space-x-2 text-sm ${isLoading ? 'opacity-50 cursor-not-allowed' : ''}`}
                                >
                                    <i className="fa-solid fa-magnifying-glass-chart"></i>
                                    <span>{isLoading ? 'Running Title Research Pipeline...' : 'Generate 10 High-CTR Titles'}</span>
                                </button>
                            </form>
                        </div>

                        {/* Pipeline Progress Indicator (Loading State) */}
                        {isLoading && (
                            <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl space-y-6">
                                <div className="flex items-center space-x-3">
                                    <i className="fa-solid fa-circle-notch fa-spin text-2xl text-indigo-500"></i>
                                    <div>
                                        <h3 className="text-sm font-extrabold text-white">Executing Niche Research Pipeline</h3>
                                        <p className="text-xs text-slate-400">Analyzing live outlier patterns for "{microNiche}"...</p>
                                    </div>
                                </div>

                                <div className="space-y-3">
                                    {PIPELINE_STEPS.map((step, idx) => {
                                        const isDone = idx < currentStepIndex;
                                        const isCurrent = idx === currentStepIndex;
                                        return (
                                            <div key={idx} className="flex items-start space-x-3 text-xs">
                                                <div className="mt-0.5">
                                                    {isDone ? (
                                                        <i className="fa-solid fa-circle-check text-emerald-400"></i>
                                                    ) : isCurrent ? (
                                                        <i className="fa-solid fa-spinner fa-spin text-indigo-400"></i>
                                                    ) : (
                                                        <i className="fa-regular fa-circle text-slate-700"></i>
                                                    )}
                                                </div>
                                                <span className={`font-semibold ${isDone ? 'text-slate-400 line-through' : isCurrent ? 'text-indigo-300 font-bold' : 'text-slate-600'}`}>
                                                    Step {idx + 1}: {step}
                                                </span>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        )}

                        {/* Results Output */}
                        {!isLoading && titles.length > 0 && (
                            <div className="space-y-4">
                                <div className="flex items-center justify-between px-2">
                                    <h2 className="text-xs font-extrabold uppercase tracking-wider text-slate-400">
                                        Top 10 Proven Title Recommendations ({microNiche})
                                    </h2>
                                    <span className="text-[11px] font-semibold text-emerald-400 bg-emerald-950/60 border border-emerald-800/80 px-2.5 py-1 rounded-lg">
                                        Grounding Active
                                    </span>
                                </div>

                                <div className="grid grid-cols-1 gap-3">
                                    {titles.map((item, index) => (
                                        <div key={index} className="bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-2xl p-5 shadow-md transition space-y-3 group">
                                            <div className="flex items-start justify-between gap-3">
                                                <div className="space-y-1.5 flex-grow">
                                                    <div className="flex items-center gap-2">
                                                        <span className="bg-indigo-950/80 border border-indigo-800/80 text-indigo-300 text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-md">
                                                            {item.format}
                                                        </span>
                                                        <span className="text-slate-500 text-xs font-bold">#{index + 1}</span>
                                                    </div>
                                                    <h3 className="text-base font-extrabold text-white leading-snug group-hover:text-indigo-200 transition">
                                                        {item.title}
                                                    </h3>
                                                </div>

                                                <button 
                                                    onClick={() => copyToClipboard(item.title, index)}
                                                    className="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold border border-slate-700 transition flex items-center gap-1.5 flex-shrink-0"
                                                    title="Copy title"
                                                >
                                                    {copiedIndex === index ? (
                                                        <>
                                                            <i className="fa-solid fa-check text-emerald-400"></i>
                                                            <span className="text-emerald-400">Copied</span>
                                                        </>
                                                    ) : (
                                                        <>
                                                            <i className="fa-regular fa-copy"></i>
                                                            <span>Copy</span>
                                                        </>
                                                    )}
                                                </button>
                                            </div>

                                            <div className="pt-2 border-t border-slate-800/80 text-xs font-medium text-slate-400 flex items-center gap-2">
                                                <i className="fa-solid fa-chart-line text-indigo-400 text-xs"></i>
                                                <span>{item.rationale}</span>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                    </main>

                    {/* Footer */}
                    <footer className="max-w-4xl w-full mx-auto px-4 py-6 text-center text-xs text-slate-600 border-t border-slate-900 mt-auto">
                        Niche Title Engine &bull; Grounded Gemini 2.5 Flash API Research &bull; Single-File React Deploy
                    </footer>
                </div>
            );
        }

        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>
